@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');
/* ==========================================================================
   AAV WORKS PRIVATE LIMITED — REDESIGNED DESIGN SYSTEM
   Matching template mockup aesthetic: dynamic shapes, colored ribbons,
   diagonal clip-paths, floating badges, and premium typography.
   AAV WORKS PRIVATE LIMITED — MAIN DESIGN SYSTEM
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600;1,700&family=Space+Grotesk:wght@500;600;700&display=swap');

/* ---------- Design Tokens ---------- */
:root {
  /* Brand Tri-Color */
  --color-primary: #C2122F;
  --color-primary-dark: #9B0E25;
  --color-primary-light: #FEE2E2;
  --color-primary-glow: rgba(194, 18, 47, 0.22);

  --color-amber: #F59E0B;
  --color-amber-dark: #D97706;
  --color-amber-light: #FEF3C7;

  --color-emerald: #10B981;
  --color-emerald-dark: #059669;
  --color-emerald-light: #D1FAE5;

  /* Neutrals */
  --color-rail-midnight: #0F172A;
  
  --color-rail-slate: #1E293B;

  /* Surfaces */
  --color-bg-canvas: #FFFFFF;
  --color-bg-subtle: #F8FAFC;
  --color-bg-muted: #F1F5F9;
  --color-border-subtle: #E2E8F0;
  --color-border-medium: #CBD5E1;
  --color-border-strong: #94A3B8;

  /* Text */
  --color-text-title: #0F172A;
  --color-text-body: #334155;
  --color-text-secondary: #475569;
  --color-text-muted: #64748B;
  --color-border-subtle: #E2E8F0;
  
  --font-sans: 'Plus Jakarta Sans', sans-serif;
  --font-mono: 'Space Grotesk', monospace;
  
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --color-text-light: #94A3B8;

  /* Elevation */
  --shadow-xs: 0 1px 2px rgba(15,23,42,0.04);
  --shadow-sm: 0 2px 4px rgba(15,23,42,0.05), 0 1px 2px rgba(15,23,42,0.03);
  --shadow-md: 0 8px 20px -4px rgba(15,23,42,0.08), 0 3px 6px -2px rgba(15,23,42,0.04);
  --shadow-lg: 0 16px 32px -6px rgba(15,23,42,0.10), 0 6px 12px -3px rgba(15,23,42,0.05);
  --shadow-xl: 0 24px 48px -8px rgba(15,23,42,0.14), 0 8px 16px -4px rgba(15,23,42,0.06);

  /* Radii */
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-full: 9999px;
  
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.05);
  --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 16px 40px rgba(15, 23, 42, 0.12);
}

*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  /* Fonts */
  --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  --font-mono: 'Space Grotesk', ui-monospace, monospace;
}

/* ---------- Base Resets ---------- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  font-family: var(--font-sans);
  color: var(--color-text-body);
  background: var(--color-bg-canvas);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  scroll-behavior: smooth;
}

::-webkit-scrollbar {
  width: 8px;
body { overflow-x: hidden; min-height: 100vh; }

::selection { background: var(--color-primary); color: #FFF; }

::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { background: #F1F5F9; }
::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 5px; border: 2px solid #F1F5F9; }
::-webkit-scrollbar-thumb:hover { background: var(--color-primary); }

:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }

/* ---------- Typography ---------- */
h1, h2, h3, h4, h5, h6 { color: var(--color-text-title); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; }
h1 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; letter-spacing: -0.03em; }
h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
h3 { font-size: clamp(1.25rem, 2vw, 1.65rem); }
p { max-width: 72ch; }
a { color: inherit; text-decoration: none; transition: color 0.2s ease; }
img { max-width: 100%; height: auto; display: block; }

/* ---------- Layout ---------- */
.container { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
@media (max-width: 640px) { .container { padding: 0 16px; } }

.section { padding: 96px 0; position: relative; }
@media (max-width: 768px) { .section { padding: 64px 0; } }
.section { padding: 80px 0; position: relative; }
@media (max-width: 768px) { .section { padding: 56px 0; } }

/* ---------- Section Tag (Red dash before label) ---------- */
/* Section Tag */
.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-primary);
  margin-bottom: 12px;
}
::-webkit-scrollbar-track {
  background: var(--color-bg-subtle);
}
::-webkit-scrollbar-thumb {
  background: var(--color-border-subtle);
  border-radius: 4px;
}
::-webkit-scrollbar-thumb:hover {
.section-tag::before {
  content: '';
  display: inline-block;
  width: 20px;
  height: 3px;
  background: var(--color-primary);
  border-radius: 2px;
}

h1, h2, h3, h4 {
  color: var(--color-text-title);
  font-weight: 800;
  line-height: 1.2;
/* Rail Ribbon Stripe */
/* Tri-Color Stripe */
.rail-ribbon-stripe { display: inline-flex; gap: 3px; height: 5px; border-radius: 3px; overflow: hidden; }
.rail-ribbon-stripe .stripe-red   { width: 28px; background: var(--color-primary); }
.rail-ribbon-stripe .stripe-amber { width: 28px; background: var(--color-amber); }
.rail-ribbon-stripe .stripe-green { width: 28px; background: var(--color-emerald); }

/* ---------- Buttons ---------- */
/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 13px 26px;
  font-size: 0.95rem;
  padding: 12px 24px;
  font-size: 0.92rem;
  font-weight: 600;
  font-family: inherit;
  border-radius: var(--radius-full);
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  transition: all 0.2s ease;
  text-decoration: none;
  line-height: 1;
}
.btn:active { transform: scale(0.97); }
.btn-primary { background: var(--color-primary); color: #FFF; }
.btn-primary:hover { background: var(--color-primary-dark); transform: translateY(-1px); }

h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
h2 { font-size: clamp(2rem, 4vw, 3rem); }
h3 { font-size: clamp(1.25rem, 2vw, 1.5rem); }
p { font-weight: 400; }
a { text-decoration: none; color: inherit; }
img { max-width: 100%; height: auto; display: block; }
.btn-primary { background: var(--color-primary); color: #FFF; box-shadow: 0 4px 14px var(--color-primary-glow); }
.btn-primary:hover { background: var(--color-primary-dark); box-shadow: 0 6px 20px rgba(194,18,47,0.35); transform: translateY(-1px); }

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
.btn-dark { background: var(--color-rail-midnight); color: #FFF; box-shadow: 0 4px 14px rgba(15,23,42,0.2); }
.btn-dark { background: var(--color-rail-midnight); color: #FFF; }
.btn-dark:hover { background: #000; transform: translateY(-1px); }

.btn-outline { background: transparent; border-color: var(--color-border-medium); color: var(--color-text-title); }
.btn-outline:hover { border-color: var(--color-text-title); background: var(--color-bg-subtle); transform: translateY(-1px); }

.btn-outline-white { background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.3); color: #FFF; backdrop-filter: blur(8px); }
.btn-outline-white:hover { background: rgba(255,255,255,0.25); border-color: #FFF; }

.service-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--color-text-title);
  transition: color 0.2s ease;
}
.service-link:hover { color: var(--color-primary); }

/* TOP BAR */
/* ---------- Top Bar ---------- */
/* Top bar & Header */
.top-bar {
  background: var(--color-rail-midnight);
  color: #E2E8F0;
  font-size: 0.85rem;
  padding: 8px 0;
  color: #94A3B8;
  font-size: 0.8rem;
  padding: 6px 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
.top-bar a { color: #E2E8F0; }
.top-bar a:hover { color: #FFF; }

/* HEADER */
/* ---------- Header ---------- */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.9);
  z-index: 900;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12px);
  z-index: 900;
  background: rgba(255,255,255,0.94);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--color-border-subtle);
  transition: all 0.3s ease;
}
.site-header.scrolled {
  box-shadow: var(--shadow-sm);
}
.header-main {
  padding: 16px 0;
}
.nav-wrapper {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.brand-logo img {
  height: 48px;
}
.desktop-nav {
  display: flex;
  gap: 32px;
}
.site-header.scrolled { box-shadow: var(--shadow-sm); background: rgba(255,255,255,0.98); }
.header-main { padding: 14px 0; }
.nav-wrapper { display: flex; align-items: center; justify-content: space-between; }
.brand-logo { display: flex; align-items: center; gap: 12px; }
.brand-logo img { height: 42px; width: auto; }
.desktop-nav { display: flex; align-items: center; gap: 32px; }
.desktop-nav { display: flex; align-items: center; gap: 30px; }
@media (max-width: 991px) { .desktop-nav { display: none; } }

.nav-link {
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--color-text-body);
  transition: color 0.2s;
  padding: 6px 0;
  position: relative;
  padding: 6px 0;
}
.nav-link:hover, .nav-link.active {
  color: var(--color-primary);
}
.mobile-menu-btn {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text-title);
}

/* BUTTONS */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  font-weight: 700;
  border-radius: var(--radius-full);
  transition: all 0.2s;
  cursor: pointer;
  border: none;
}
.btn-primary {
.nav-link:hover, .nav-link.active { color: var(--color-primary); }
.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 2px;
  background: var(--color-primary);
  color: #FFF;
  border-radius: 1px;
}
.btn-primary:hover {
  background: #A00E26;
  transform: translateY(-2px);
}
.btn-dark {
  background: var(--color-rail-midnight);
  color: #FFF;
}
.btn-dark:hover {
  background: #000;
  transform: translateY(-2px);
}
.btn-outline {
  border: 1px solid var(--color-border-subtle);
  background: transparent;
}
.btn-outline:hover {
  background: var(--color-bg-subtle);
}

/* FLOATING BTN */
.floating-contact-btn {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 90;
  background: var(--color-primary);
  color: #FFF;
  padding: 16px 24px;
  border-radius: var(--radius-full);
  font-weight: 700;
  box-shadow: var(--shadow-md);
  border: none;
  cursor: pointer;
  transition: transform 0.2s;
.mobile-menu-btn { display: none; background: transparent; border: none; color: var(--color-text-title); cursor: pointer; padding: 8px; }
@media (max-width: 991px) { .mobile-menu-btn { display: flex; align-items: center; } }
.mobile-menu-btn { display: none; background: none; border: none; cursor: pointer; }
@media (max-width: 991px) { .mobile-menu-btn { display: flex; } }

/* Mobile Drawer */
/* Drawer */
.mobile-nav-drawer {
  position: fixed; top: 0; right: -100%;
  width: 82%; max-width: 380px; height: 100vh;
  width: 82%; max-width: 360px; height: 100vh;
  background: #FFF; z-index: 1000;
  box-shadow: -10px 0 30px rgba(0,0,0,0.2);
  transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex; flex-direction: column; padding: 24px; overflow-y: auto;
  transition: right 0.35s ease;
  display: flex; flex-direction: column; padding: 24px;
}
.floating-contact-btn:hover {
  transform: scale(1.05);
}
.mobile-nav-drawer.open { right: 0; }

/* DRAWER */
.drawer-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.5);
  backdrop-filter: blur(4px);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  position: fixed; inset: 0;
  background: rgba(15,23,42,0.6); backdrop-filter: blur(4px);
  z-index: 999; opacity: 0; visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}
.drawer-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}
.mobile-nav-drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 100%;
  max-width: 400px;
  height: 100vh;
  background: #FFF;
  z-index: 201;
  padding: 32px;
  transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--shadow-lg);
}
.mobile-nav-drawer.open {
  right: 0;
}
.modal-close-btn {
  background: none;
  border: none;
  font-size: 2rem;
  cursor: pointer;
}
.drawer-backdrop.open { opacity: 1; visibility: visible; }

/* SECTION UTILS */
.section-tag {
  color: var(--color-primary);
  font-weight: 800;
/* ---------- Floating Contact ---------- */
/* Floating Contact Button */
.floating-contact-btn {
  position: fixed; right: 0; top: 50%; transform: translateY(-50%);
  background: var(--color-primary); color: #FFF;
  padding: 12px 16px; font-weight: 700; font-size: 0.88rem;
  padding: 12px 14px; font-weight: 700; font-size: 0.85rem;
  border: none; cursor: pointer; z-index: 850;
  border-radius: var(--radius-md) 0 0 var(--radius-md);
  box-shadow: -4px 0 16px rgba(194,18,47,0.4);
  box-shadow: -4px 0 16px rgba(194,18,47,0.3);
  writing-mode: vertical-rl; text-orientation: mixed;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  font-size: 0.85rem;
  display: block;
  margin-bottom: 12px;
  transition: all 0.2s ease;
}
.floating-contact-btn:hover { background: var(--color-primary-dark); padding-right: 20px; }

/* HERO SECTION */
/* ================================================================
   HERO SECTION — Dynamic diagonal layout
   HERO SECTION — EXACT USER BACKGROUND
   ================================================================ */
.hero-section {
  padding: 80px 0;
  background: #FFF;
  position: relative;
  background: #FAFAFA;
  min-height: 540px;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 48px 0 64px;
  background-color: #FFFFFF;
  background-image: url('/assets/images/hero_train_bg.png');
  background-repeat: no-repeat;
  background-position: right center;
  background-size: contain;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  grid-template-columns: 1fr 1.1fr;
  gap: 32px;
  align-items: center;
  position: relative;
@media (max-width: 991px) {
  .hero-section {
    background-size: cover;
    background-position: 70% center;
  }
}
.hero-headline {
  margin-bottom: 24px;
@media (max-width: 991px) { .hero-grid { grid-template-columns: 1fr; } }

.hero-content { z-index: 2; }
.hero-headline { margin-top: 16px; margin-bottom: 20px; line-height: 1.08; }
.hero-subtext { font-size: 1.05rem; color: var(--color-text-secondary); margin-bottom: 32px; line-height: 1.7; }
.hero-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 36px; }
.hero-badges-row {
  display: flex; align-items: center; gap: 16px;
  padding-top: 24px; border-top: 1px solid var(--color-border-subtle);
}
.hero-subtext {
  font-size: 1.125rem;
  color: var(--color-text-muted);
  margin-bottom: 40px;
.badge-tag { font-size: 0.76rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }

/* Hero Visual — Diagonal clip-path */
.hero-visual-col {
.hero-content {
  max-width: 540px;
  position: relative;
  display: flex;
  justify-content: center;
  z-index: 3;
  padding: 40px 0;
}

.hero-visual-card {
  position: relative;
  /* Diagonal clip path for dynamic feel */
  clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
  border-radius: var(--radius-xl);
  overflow: hidden;
  clip-path: polygon(18% 0, 100% 0, 100% 100%, 0% 100%);
  border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
.hero-headline {
  font-size: clamp(2.6rem, 5vw, 4.2rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.03em;
  margin: 14px 0 20px;
  color: #07111C;
}
.hero-visual-col::before {
  content: "A BRIGHTER TOMORROW ON TRACK";
.hero-visual-card img {
  width: 100%;
  height: 100%;
  min-height: 420px;
  object-fit: cover;
}

/* Decorative AAV ribbon behind hero image */
.hero-ribbon-decoration {
  position: absolute;
  bottom: -40px;
  top: -30px;
  right: 60px;
  width: 200px;
  height: 520px;
  z-index: 3;
  pointer-events: none;
.hero-subtext {
  font-size: 1.05rem;
  color: var(--color-text-secondary);
  line-height: 1.65;
  margin-bottom: 28px;
}

/* Floating badges — SAFER / SMARTER / STRONGER / TOGETHER */
.hero-floating-badges {
  position: absolute;
  top: 32px;
  right: 0;
  font-weight: 800;
  color: rgba(15, 23, 42, 0.05);
  font-size: 3rem;
  z-index: -1;
  white-space: nowrap;
}
.rail-ribbon-stripe {
  z-index: 4;
.hero-actions {
  display: flex;
  height: 6px;
  width: 120px;
  border-radius: 3px;
  overflow: hidden;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}
.stripe-red { background: var(--color-primary); flex: 1; }
.stripe-amber { background: var(--color-amber); flex: 1; }
.stripe-green { background: var(--color-emerald); flex: 1; }
.badge-tag {
  font-size: 0.75rem;
.hero-floating-badges .badge-word {
  font-size: 0.82rem;
  font-weight: 800;
  color: var(--color-text-muted);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-text-title);
}
.floating-status-pill {
.hero-floating-badges .rail-ribbon-stripe {
  margin-top: 6px;
}

/* Tagline right — A BRIGHTER TOMORROW ON TRACK */
.hero-tagline-right {
  position: absolute;
  bottom: 24px;
  left: 32px;
  background: rgba(255,255,255,0.9);
  backdrop-filter: blur(8px);
  padding: 16px;
  border-radius: var(--radius-lg);
.hero-badges-row {
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow-md);
  right: 0;
  z-index: 4;
  text-align: right;
  line-height: 1.35;
  gap: 16px;
  padding-top: 20px;
  border-top: 1px solid var(--color-border-subtle);
}
.hero-tagline-right .tagline-word {
  display: block;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-text-title);
}
.live-pulse-dot {
  width: 12px;
  height: 12px;
  background: var(--color-emerald);
  border-radius: 50%;
  animation: pulse 2s infinite;
.hero-tagline-right .tagline-accent {
  color: var(--color-primary);
}
@keyframes pulse {
  0% { box-shadow: 0 0 0 0 rgba(16,185,129,0.4); }
  70% { box-shadow: 0 0 0 10px rgba(16,185,129,0); }
  100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }

/* Floating overlay on image */
.hero-image-overlay-text {
.hero-tagline-right {
  position: absolute;
  bottom: 20px;
  right: 20px;
  z-index: 5;
  text-align: right;
  padding: 10px 16px;
  background: rgba(15,23,42,0.75);
  backdrop-filter: blur(6px);
  border-radius: var(--radius-md);
  top: 70px;
  right: 48px;
  z-index: 3;
  text-align: left;
  border-left: 2px solid #0F172A;
  padding-left: 14px;
}
.hero-image-overlay-text span {
.hero-tagline-right span {
  display: block;
  font-size: 0.72rem;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #FFF;
  color: #0F172A;
  line-height: 1.6;
}

/* METRICS */
@media (max-width: 991px) {
  .hero-visual-card {
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    border-radius: var(--radius-lg);
  }
  .hero-floating-badges,
  .hero-tagline-right,
  .hero-ribbon-decoration { display: none; }
@media (max-width: 1024px) {
  .hero-tagline-right { display: none; }
}

/* ================================================================
   METRICS STRIP
   ================================================================ */
.metrics-strip {
  background: #FFF;
  border-top: 1px solid var(--color-border-subtle);
  border-bottom: 1px solid var(--color-border-subtle);
  padding: 36px 0;
  padding: 32px 0;
}
.metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}
@media (max-width: 991px) { .metrics-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .metrics-grid { grid-template-columns: 1fr; } }

.metric-card { display: flex; align-items: center; gap: 16px; padding: 8px 16px; border-right: 1px solid var(--color-border-subtle); }
.metric-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 4px 16px;
  border-right: 1px solid var(--color-border-subtle);
}
.metric-card:last-child { border-right: none; }
@media (max-width: 991px) { .metric-card { border-right: none; } }

.metric-icon-wrap {
  width: 48px; height: 48px;
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--color-bg-subtle);
  padding: 48px 0;
  color: var(--color-primary);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.metrics-grid {
.metric-number {
  font-family: var(--font-mono);
  font-size: 2.2rem; font-weight: 700; line-height: 1.1;
  font-size: 2rem; font-weight: 700; line-height: 1.1;
  color: var(--color-text-title);
  font-variant-numeric: tabular-nums;
}
.metric-label { font-size: 0.85rem; font-weight: 600; color: var(--color-text-muted); }

/* ================================================================
   ABOUT SECTION — 3-column: text | image | quote
   ABOUT SECTION
   ================================================================ */
.about-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  grid-template-columns: 1fr 1.2fr 0.9fr;
  gap: 40px;
  grid-template-columns: 1fr 1.25fr 0.95fr;
  gap: 36px;
  align-items: center;
}
.metric-card {
@media (max-width: 991px) { .about-grid { grid-template-columns: 1fr; } }

.about-image-wrap {
  position: relative;
  border-radius: var(--radius-lg);
  border-radius: 20px 4px 20px 20px;
  overflow: hidden;
  box-shadow: var(--shadow-xl);
  clip-path: polygon(0 0, 88% 0, 100% 100%, 0 100%);
  box-shadow: 0 16px 36px rgba(15,23,42,0.1);
}
.about-image-wrap img {
  width: 100%;
  aspect-ratio: 4 / 3;
  aspect-ratio: 16/9;
  object-fit: cover;
}
.about-image-overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(15,23,42,0.88) 100%);
  padding: 20px 24px;
  color: #FFF;
}
.about-image-overlay .overlay-words {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-direction: column;
  gap: 2px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.metric-icon-wrap {
  width: 48px;
  height: 48px;
  background: #FFF;
  border-radius: var(--radius-full);
.about-image-overlay .overlay-highlight {
  font-size: 0.92rem;
  font-weight: 800;
  color: var(--color-amber);
  margin-top: 4px;
}

.about-quote-col {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary);
  box-shadow: var(--shadow-sm);
  flex-direction: column;
  gap: 24px;
}
.metric-number {
  font-family: var(--font-mono);
  font-size: 2rem;
  font-weight: 700;
.about-quote-text {
  font-size: 1.4rem;
  font-size: 1.35rem;
  font-style: italic;
  font-weight: 600;
  color: var(--color-text-title);
  line-height: 1.4;
  color: #475569;
  line-height: 1.45;
  position: relative;
  padding-left: 0;
  padding-left: 20px;
  border-left: 3px solid var(--color-primary);
}
.metric-label {
  font-size: 0.875rem;
.about-quote-text::before {
  content: '\201C';
  font-size: 4rem;
  color: var(--color-border-subtle);
  position: absolute;
  top: -20px;
  left: -5px;
  line-height: 1;
  font-style: normal;
}
.about-quote-source {
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--color-text-muted);
  font-weight: 600;
  text-transform: uppercase;
}

/* ABOUT SECTION */
.section {
  padding: 96px 0;
/* About value cards */
/* 4 Value Pillars */
.about-values-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-top: 64px;
  margin-top: 56px;
}
.section img {
  clip-path: polygon(0 0, 100% 0, 95% 100%, 5% 100%);
  border-radius: var(--radius-xl);
@media (max-width: 991px) { .about-values-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px) { .about-values-grid { grid-template-columns: 1fr; } }

.value-card {
  padding: 24px 20px;
  background: var(--color-bg-subtle);
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border-subtle);
  transition: all 0.3s ease;
  transition: all 0.25s ease;
}
.value-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
  border-color: var(--color-border-medium);
}
.value-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
.value-card-icon {
  width: 44px; height: 44px;
  width: 42px; height: 42px;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 14px;
}
.value-card-title { font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
.value-card-desc { font-size: 0.82rem; color: var(--color-text-secondary); line-height: 1.5; }
.value-card-desc { font-size: 0.82rem; color: var(--color-text-secondary); }

/* SERVICES */
/* ================================================================
   SERVICES SECTION
   ================================================================ */
.services-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  margin-top: 48px;
  gap: 20px;
  margin-top: 40px;
}
@media (max-width: 1024px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .services-grid { grid-template-columns: 1fr; } }

.service-card {
  background: #FFF;
  padding: 32px;
  border-radius: var(--radius-xl);
  background: var(--color-bg-canvas);
  border: 1px solid var(--color-border-subtle);
  transition: all 0.3s;
  border-radius: var(--radius-lg);
  padding: 32px 24px;
  padding: 28px 20px;
  display: flex;
  flex-direction: column;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transition: all 0.3s ease;
}
.service-card:hover {
  transform: translateY(-8px);
  transform: translateY(-6px);
  border-color: var(--color-border-strong);
  box-shadow: var(--shadow-lg);
  border-color: var(--color-primary);
}
.service-card:hover .service-link { color: var(--color-primary); }
.service-card:hover { transform: translateY(-6px); box-shadow: 0 12px 28px rgba(15,23,42,0.08); border-color: var(--color-border-strong); }

.service-icon-box {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--color-bg-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
  color: var(--color-primary);
  width: 56px; height: 56px;
  width: 52px; height: 52px;
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 24px; flex-shrink: 0;
  margin-bottom: 20px;
}
.service-title {
  margin-bottom: 16px;
}
.service-desc {
  color: var(--color-text-muted);
  font-size: 0.95rem;
  margin-bottom: 24px;
}
.service-card.projects .service-icon-box   { background: #FEE2E2; color: var(--color-primary); }
.service-card.assurance .service-icon-box  { background: var(--color-amber-light); color: var(--color-amber-dark); }
.service-card.software .service-icon-box   { background: var(--color-emerald-light); color: var(--color-emerald-dark); }
.service-card.projects .service-icon-box    { background: #FEE2E2; color: var(--color-primary); }
.service-card.assurance .service-icon-box   { background: var(--color-amber-light); color: var(--color-amber-dark); }
.service-card.software .service-icon-box    { background: var(--color-emerald-light); color: var(--color-emerald-dark); }
.service-card.engineering .service-icon-box { background: #E2E8F0; color: var(--color-rail-slate); }

/* PRODUCTS SECTION - REWRITTEN TO LIGHT STRIP THEME */
.products-dark-section {
  background: var(--color-bg-subtle);
  padding: 80px 0;
.service-title { font-size: 1.22rem; font-weight: 700; margin-bottom: 12px; }
.service-desc { font-size: 0.92rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 24px; flex-grow: 1; }
.service-title { font-size: 1.15rem; font-weight: 700; margin-bottom: 10px; }
.service-desc { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.55; margin-bottom: 20px; flex-grow: 1; }

/* ================================================================
   PRODUCTS SECTION — Horizontal strip + expandable dark panels
   PRODUCTS SECTION
   ================================================================ */
.products-strip-section {
  background: #FFF;
  padding: 48px 0 24px;
  border-bottom: 1px solid var(--color-border-subtle);
}
.products-dark-section h2 { color: var(--color-text-title); }
.products-nav-tabs {
.products-strip {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14px;
  margin-top: 24px;
}
@media (max-width: 991px) { .products-strip { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 640px) { .products-strip { grid-template-columns: 1fr; } }

.products-strip-item {
  display: flex;
  gap: 16px;
  margin-top: 40px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--color-border-subtle);
  overflow-x: auto;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12px;
}
.product-tab-btn {
  gap: 12px;
  padding: 16px;
  background: #FFF;
.products-strip-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px;
  background: var(--color-bg-subtle);
  border: 1px solid var(--color-border-subtle);
  padding: 12px 24px;
  border-radius: var(--radius-full);
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--color-text-muted);
  color: var(--color-text-title);
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  font-weight: 700;
  box-shadow: 0 4px 12px rgba(15,23,42,0.03);
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
  transition: all 0.2s ease;
}
.product-tab-btn.active, .product-tab-btn:hover {
.products-strip-item:hover {
  border-color: var(--color-text-title);
  background: #FFF;
  box-shadow: var(--shadow-sm);
.products-strip-item:hover, .products-strip-item.active {
  border-color: var(--color-primary);
  box-shadow: 0 6px 18px rgba(194,18,47,0.1);
  transform: translateY(-2px);
}
.products-strip-item .strip-dot {
  width: 10px; height: 10px; border-radius: 50%;
}
.products-strip-item .strip-subtext {
  font-size: 0.75rem; font-weight: 500; color: var(--color-text-muted);
}
.products-strip-item .strip-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }

/* Dark expandable panels (keep working with existing JS) */
/* Products Dark Detail Section */
.products-dark-section {
  background: var(--color-rail-midnight);
  color: #FFF;
  border-color: var(--color-rail-midnight);
  padding: 72px 0;
  position: relative;
  overflow: hidden;
  padding: 64px 0;
}
.product-panel {
  display: none;
  animation: fadeIn 0.4s ease;
  margin-top: 40px;
.products-dark-section .section-tag { color: #F87171; }
.products-dark-section .section-tag::before { background: #F87171; }

.products-nav-tabs {
  display: flex; gap: 12px;
  overflow-x: auto; padding-bottom: 8px;
  margin-top: 36px;
  border-bottom: 1px solid rgba(255,255,255,0.12);
}
.product-panel.active {
  display: block;
.product-tab-btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 12px 20px;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  background: transparent; border: none;
  color: #94A3B8; font-size: 0.92rem; font-weight: 600;
  cursor: pointer; transition: all 0.2s ease; white-space: nowrap;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.product-panel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
}
.product-tab-btn:hover { color: #FFF; background: rgba(255,255,255,0.05); }
.product-tab-btn.active { color: #FFF; background: rgba(255,255,255,0.1); border-bottom: 3px solid var(--color-primary); }

.product-panel { display: none; padding-top: 40px; }
.product-panel { display: none; }
.product-panel.active { display: block; }
.product-panel-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
@media (max-width: 991px) { .product-panel-grid { grid-template-columns: 1fr; } }

.product-badge {
  display: inline-block;
  padding: 6px 12px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 700;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 12px; border-radius: var(--radius-full);
  font-size: 0.75rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  margin-bottom: 16px;
  background: rgba(194,18,47,0.1);
  color: var(--color-primary);
}
.spec-list {
  list-style: none;
  margin-top: 24px;
}
.spec-item {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
  color: var(--color-text-body);
}
.spec-list { list-style: none; margin-top: 24px; display: flex; flex-direction: column; gap: 12px; }
.spec-item { display: flex; align-items: flex-start; gap: 10px; font-size: 0.95rem; color: #CBD5E1; }
.spec-list { list-style: none; margin-top: 20px; display: flex; flex-direction: column; gap: 12px; }
.spec-item { display: flex; align-items: flex-start; gap: 10px; font-size: 0.92rem; color: #CBD5E1; }
.spec-item svg { color: var(--color-emerald); flex-shrink: 0; margin-top: 4px; }

/* CONSOLE PREVIEW */
/* Console Preview */
.console-preview-card {
  background: var(--color-rail-midnight);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  color: #FFF;
  background: #020617;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-lg);
  padding: 24px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  padding: 20px;
}
.console-header {
  background: rgba(255,255,255,0.05);
  padding: 16px 24px;
  display: flex;
  align-items: center;
  gap: 16px;
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 14px;
  padding-bottom: 12px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  margin-bottom: 16px;
  margin-bottom: 14px;
}
.console-dots { display: flex; gap: 8px; }
.console-dot { width: 12px; height: 12px; border-radius: 50%; }
.console-dots { display: flex; gap: 6px; }
.console-dot { width: 10px; height: 10px; border-radius: 50%; }
.console-dot.red { background: #EF4444; }
.console-dot.yellow { background: #F59E0B; }
.console-dot.yellow { background: #FBBF24; }
.console-dot.green { background: #10B981; }
.console-title { font-family: var(--font-mono); font-size: 0.85rem; color: #94A3B8; }
#simulatorOutput {
  font-family: var(--font-mono);
  padding: 24px;
  height: 240px;
  overflow-y: auto;
  font-size: 0.9rem;

/* ================================================================
   FEATURED PROJECTS BANNER
   ================================================================ */
.featured-project-banner {
  position: relative;
  background-image: url('/assets/images/featured_viaduct_exact.jpg');
  background-size: cover;
  background-position: center;
  border-radius: var(--radius-xl);
  overflow: hidden;
  color: #FFF;
  padding: 60px 48px;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.console-title { font-family: var(--font-mono); font-size: 0.8rem; color: #94A3B8; letter-spacing: 0.05em; }
@media (max-width: 768px) {
  .featured-project-banner { flex-direction: column; align-items: flex-start; gap: 24px; padding: 40px 24px; }
}

/* PROJECTS SECTION */
/* ================================================================
   PROJECTS SECTION
   SPLIT NEWS & CLIENTS (Proper 50-50 Split with Vertical Divider)
   ================================================================ */
.projects-grid {
.news-clients-split-section {
  padding: 64px 0;
  background: var(--color-bg-subtle);
  border-top: 1px solid var(--color-border-subtle);
  border-bottom: 1px solid var(--color-border-subtle);
}

.news-clients-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  gap: 28px;
  margin-top: 40px;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}
@media (max-width: 991px) { .projects-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .projects-grid { grid-template-columns: 1fr; } }
@media (max-width: 991px) {
  .news-clients-grid { grid-template-columns: 1fr; gap: 48px; }
}

.project-card {
  background: #FFF;
  border-radius: var(--radius-xl);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex; flex-direction: column;
.news-half {
  padding-right: 48px;
}
.project-card:hover { transform: translateY(-6px); border-color: var(--color-border-strong); box-shadow: var(--shadow-lg); }
@media (max-width: 991px) { .news-half { padding-right: 0; } }

.project-thumb { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #0F172A; }
.project-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
.project-card:hover .project-thumb img { transform: scale(1.04); }
.clients-half {
  padding-left: 48px;
  border-left: 1px solid var(--color-border-medium);
}
@media (max-width: 991px) { .clients-half { padding-left: 0; border-left: none; } }

.project-body { padding: 24px; display: flex; flex-direction: column; flex-grow: 1; }
.project-meta { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--color-primary); letter-spacing: 0.1em; margin-bottom: 8px; }
.project-heading { font-size: 1.18rem; font-weight: 700; margin-bottom: 10px; }
.project-snippet { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 20px; flex-grow: 1; }
.split-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24px;
}
.split-header h3 {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--color-text-title);
  margin-top: 4px;
}

/* ================================================================
   NEWS + CLIENTS — Side by side layout
   ================================================================ */
.news-clients-split {
/* News cards row */
.news-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
@media (max-width: 991px) { .news-clients-split { grid-template-columns: 1fr; } }
@media (max-width: 640px) { .news-row { grid-template-columns: 1fr; } }

.news-cards-row { display: flex; flex-direction: column; gap: 16px; margin-top: 24px; }

.news-card {
  display: flex; align-items: center; gap: 16px;
  padding: 16px;
  background: var(--color-bg-canvas);
.news-card-mini {
  background: #FFF;
  border: 1px solid var(--color-border-subtle);
  transition: transform 0.3s;
  border-radius: var(--radius-md);
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  box-shadow: 0 2px 6px rgba(15,23,42,0.03);
  transition: all 0.2s ease;
}
.project-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-md);
.news-card:hover { border-color: var(--color-border-strong); box-shadow: var(--shadow-sm); }
.news-card-mini:hover { border-color: var(--color-border-strong); transform: translateY(-2px); }
.news-card-mini img {
  width: 52px; height: 52px;
  border-radius: var(--radius-sm);
  object-fit: cover;
  flex-shrink: 0;
}
.news-date-tag { font-size: 0.68rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; margin-bottom: 4px; }
.news-card-title { font-size: 0.78rem; font-weight: 700; color: var(--color-text-title); line-height: 1.25; }

.news-thumb { width: 72px; height: 56px; border-radius: var(--radius-sm); overflow: hidden; flex-shrink: 0; background: #1E293B; }
.news-thumb img { width: 100%; height: 100%; object-fit: cover; }
.news-date { font-size: 0.75rem; font-weight: 700; color: var(--color-primary); letter-spacing: 0.05em; margin-bottom: 4px; }
.news-title { font-size: 0.9rem; font-weight: 700; color: var(--color-text-title); line-height: 1.35; }
/* Clients cards row */
.clients-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10px;
}
@media (max-width: 640px) { .clients-row { grid-template-columns: repeat(2, 1fr); } }

/* Clients */
.clients-grid {
  display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
  margin-top: 24px;
.client-card-box {
  background: #FFF;
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-md);
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  box-shadow: 0 2px 6px rgba(15,23,42,0.03);
  transition: all 0.2s ease;
}
.project-thumb img {
  width: 100%;
  aspect-ratio: 16/10;
  object-fit: cover;
  clip-path: none;
.client-logo-item {
  height: 44px; display: flex; align-items: center;
  filter: grayscale(80%) opacity(0.85);
  transition: all 0.25s ease;
}
.project-body {
  padding: 24px;
.client-logo-item:hover { filter: grayscale(0%) opacity(1); transform: translateY(-2px); }
.client-logo-item img { max-height: 40px; width: auto; }
.client-card-box:hover { border-color: var(--color-primary); transform: translateY(-2px); }
.client-card-box img { max-height: 42px; max-width: 85%; object-fit: contain; }
.client-card-box.more-card { font-size: 0.82rem; font-weight: 700; color: var(--color-text-secondary); }

/* ================================================================
   CAREERS CTA
   CAREERS BANNER
   ================================================================ */
.career-cta-card {
.career-banner-wrap {
  position: relative;
  background: linear-gradient(135deg, #C2122F 0%, #0F172A 100%);
  background-image: url('/assets/images/career_banner_exact.jpg');
  background-size: cover;
  background-position: center;
  border-radius: var(--radius-xl);
  overflow: hidden;
  color: #FFF;
  padding: 64px 48px;
  box-shadow: var(--shadow-xl);
  padding: 56px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.project-meta {
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--color-primary);
@media (max-width: 768px) { .career-cta-card { padding: 40px 24px; } }

.career-cta-bg {
  position: absolute; top: 0; right: 0; bottom: 0;
  width: 50%; opacity: 0.2;
  object-fit: cover; pointer-events: none;
@media (max-width: 768px) {
  .career-banner-wrap { flex-direction: column; align-items: flex-start; gap: 24px; padding: 40px 24px; }
}
@media (max-width: 768px) { .career-cta-bg { display: none; } }

.career-cta-content { position: relative; z-index: 2; max-width: 600px; }

.career-right-text {
  position: absolute;
  top: 50%; right: 48px;
  transform: translateY(-50%);
  text-align: right;
  z-index: 3;
}
.career-right-text .right-word {
  display: block;
  font-size: 0.88rem;
  font-weight: 800;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-bottom: 8px;
  color: rgba(255,255,255,0.7);
}
.project-heading {
  margin-bottom: 12px;
.career-right-text .right-word.accent { color: var(--color-amber); }
@media (max-width: 768px) { .career-right-text { display: none; } }

/* ================================================================
   FOOTER
   ================================================================ */
.site-footer {
  background: var(--color-rail-midnight);
  color: #94A3B8;
  padding-top: 80px;
  padding-bottom: 40px;
  padding-top: 64px;
  padding-bottom: 36px;
  border-top: 1px solid rgba(255,255,255,0.08);
}
.project-snippet {
  color: var(--color-text-muted);
  font-size: 0.95rem;
  margin-bottom: 24px;
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.5fr;
  gap: 48px;
  margin-bottom: 60px;
  gap: 40px;
  margin-bottom: 48px;
}
@media (max-width: 991px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 640px) { .footer-grid { grid-template-columns: 1fr; } }

/* MODALS & UTILS */
.footer-logo img { height: 48px; margin-bottom: 20px; }
.footer-title { color: #FFF; font-size: 1rem; font-weight: 700; margin-bottom: 20px; }
.footer-links { list-style: none; display: flex; flex-direction: column; gap: 12px; }
.footer-link { font-size: 0.9rem; color: #94A3B8; transition: color 0.2s ease; }
.footer-logo img { height: 44px; margin-bottom: 16px; }
.footer-title { color: #FFF; font-size: 0.95rem; font-weight: 700; margin-bottom: 16px; }
.footer-links { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.footer-link { font-size: 0.88rem; color: #94A3B8; }
.footer-link:hover { color: #FFF; }

.footer-office-card { margin-bottom: 16px; }
.footer-office-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #E2E8F0; letter-spacing: 0.08em; margin-bottom: 4px; }
.footer-office-text { font-size: 0.85rem; color: #94A3B8; line-height: 1.5; }
.footer-office-card { margin-bottom: 14px; }
.footer-office-title { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: #E2E8F0; margin-bottom: 3px; }
.footer-office-text { font-size: 0.82rem; color: #94A3B8; line-height: 1.5; }

.footer-bottom {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 32px;
  padding-top: 28px;
  border-top: 1px solid rgba(255,255,255,0.08);
  font-size: 0.82rem;
  font-size: 0.8rem;
  flex-wrap: wrap; gap: 16px;
}
.footer-legal-links { display: flex; gap: 24px; }
.footer-legal-links { display: flex; gap: 20px; }

/* ================================================================
   MODALS
   MODALS & TOASTS
   ================================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.6);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  position: fixed; inset: 0;
  background: rgba(15,23,42,0.75);
  backdrop-filter: blur(8px);
  z-index: 2000;
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
  opacity: 0; visibility: hidden;
  transition: all 0.25s ease;
}
.modal-overlay.active {
  opacity: 1;
  pointer-events: auto;
}
.modal-overlay.active { opacity: 1; visibility: visible; }

.modal-window {
  background: #FFF;
  padding: 32px;
  border-radius: var(--radius-xl);
  width: 100%;
  max-width: 500px;
  transform: translateY(20px);
  transition: transform 0.3s;
  border-radius: var(--radius-lg);
  max-width: 640px; width: 100%;
  max-width: 620px; width: 100%;
  max-height: 90vh; overflow-y: auto;
  box-shadow: var(--shadow-xl);
  box-shadow: 0 24px 48px rgba(0,0,0,0.25);
  position: relative;
  transform: scale(0.95);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
.modal-overlay.active .modal-window {
  transform: translateY(0);
.modal-overlay.active .modal-window { transform: scale(1); }

.modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24px 28px;
  padding: 20px 24px;
  border-bottom: 1px solid var(--color-border-subtle);
}
.modal-close-btn {
  background: transparent; border: none;
  font-size: 1.6rem; color: var(--color-text-muted);
  cursor: pointer; line-height: 1; padding: 4px;
  background: none; border: none; font-size: 1.5rem; color: var(--color-text-muted); cursor: pointer;
}
.modal-close-btn:hover { color: var(--color-primary); }
.modal-body { padding: 28px; }
.modal-body { padding: 24px; }

.toast-container {
  position: fixed;
  bottom: 24px;
  left: 24px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.toast {
  background: var(--color-rail-midnight);
  color: #FFF;
  padding: 16px 24px;
/* Video Modal */
.video-modal-window { max-width: 900px; background: #000; border-radius: var(--radius-md); overflow: hidden; }
.video-modal-window { max-width: 850px; background: #000; }
.video-container { position: relative; padding-bottom: 56.25%; height: 0; }
.video-container iframe, .video-container video { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.video-container video, .video-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }

/* ================================================================
   FORMS
   ================================================================ */
.form-group { margin-bottom: 20px; }
.form-label { display: block; font-size: 0.88rem; font-weight: 600; color: var(--color-text-title); margin-bottom: 8px; }
.form-label .required { color: var(--color-primary); }

.form-group { margin-bottom: 16px; }
.form-label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }
.form-input, .form-select, .form-textarea {
  width: 100%; padding: 12px 16px;
  font-family: inherit; font-size: 0.95rem;
  color: var(--color-text-title); background: #FFF;
  width: 100%; padding: 10px 14px;
  font-family: inherit; font-size: 0.92rem;
  border: 1px solid var(--color-border-medium);
  border-radius: var(--radius-md);
  font-weight: 600;
  box-shadow: var(--shadow-lg);
  animation: toastIn 0.3s forwards;
  transition: all 0.2s ease;
}
@keyframes toastIn {
  from { opacity: 0; transform: translateX(-20px); }
  to { opacity: 1; transform: translateX(0); }
.form-input:focus, .form-select:focus, .form-textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px var(--color-primary-glow);
  outline: none; border-color: var(--color-primary);
}
.form-textarea { resize: vertical; min-height: 110px; }
.form-textarea { resize: vertical; min-height: 90px; }

.file-dropzone {
  border: 2px dashed var(--color-border-subtle);
  border-radius: var(--radius-lg);
  padding: 32px;
  text-align: center;
  color: var(--color-text-muted);
  transition: border-color 0.2s;
  border: 2px dashed var(--color-border-medium);
  border-radius: var(--radius-md);
  padding: 20px; text-align: center;
  background: var(--color-bg-subtle);
  cursor: pointer; transition: all 0.2s ease;
}
.file-dropzone:hover {
  border-color: var(--color-primary);
}
.file-dropzone:hover { border-color: var(--color-primary); background: var(--color-primary-light); }

/* RESPONSIVE */
@media (max-width: 991px) {
  .desktop-nav { display: none; }
  .mobile-menu-btn { display: block; }
  .hero-grid, .product-panel-grid { grid-template-columns: 1fr; }
  .metrics-grid, .services-grid, .projects-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-visual-card { clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%); }
/* ================================================================
   TOAST NOTIFICATIONS
   ================================================================ */
.toast-container {
  position: fixed; bottom: 24px; right: 24px; z-index: 3000;
  display: flex; flex-direction: column; gap: 12px;
  display: flex; flex-direction: column; gap: 10px;
}
@media (max-width: 640px) {
  .metrics-grid, .services-grid, .projects-grid { grid-template-columns: 1fr; }
  h1 { font-size: 2.5rem; }
  .hero-section { padding: 48px 0; }
.toast {
  background: #0F172A; color: #FFF;
  padding: 14px 20px; border-radius: var(--radius-md);
  box-shadow: var(--shadow-xl);
  display: flex; align-items: center; gap: 12px;
  font-size: 0.92rem;
  animation: slideInRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  border-left: 4px solid var(--color-emerald);
  background: #0F172A; color: #FFF; padding: 12px 18px; border-radius: var(--radius-md);
  font-size: 0.9rem; border-left: 4px solid var(--color-emerald);
  box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}
@keyframes slideInRight {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
